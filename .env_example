# HSM Environment Configuration Example

# Path to the global registry (optional, defaults to ./hsm-registry)
# HSM_REGISTRY_PATH=/path/to/your/shared/registry

# Enable debug mode for tests (saves artifacts in debug_tests/)
# 0 = disabled, 1 = enabled
HSM_DEBUG_TESTS=0

# Number of test runs to keep in debug_tests/
HSM_KEEP_RUNS=10

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO